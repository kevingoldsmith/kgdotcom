Options -Indexes
ErrorDocument 403 /403page.html
ErrorDocument 404 /404page.html

# Permanent moves: 301 rather than the default 302, so link equity follows.
Redirect 301 /discography.html /music.html
Redirect 301 /photos.html /photography.html
Redirect 301 /music/index.html /music.html
Redirect 301 /index.php /index.html
Redirect 301 /labs/index.html /resume.html
Redirect 301 /photography/index.html /photography.html
Redirect 301 /photography/ /photography.html

RewriteEngine On

# NOTE: a rule forcing the bare domain used to live here and was reverted. It
# caused a redirect loop, because DreamHost is configured to serve this site as
# www.kevingoldsmith.com and redirects the bare domain to it. Two redirects
# pointing at each other take the site down.
#
# To make kevingoldsmith.com canonical, change the host's domain setting first,
# so DreamHost stops forcing www. Only then add the rewrite. The generator
# already emits canonical URLs without www, so no code change is needed.

RewriteCond %{HTTPS} !=on
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

AddType 'application/xml; charset=UTF-8' xml
